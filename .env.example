# ============================================================
# Santa Fe Beach Club - Environment Variables EXAMPLE
# ============================================================
# Copy this file to .env and fill in your real values.
# The .env file is gitignored and must NEVER be committed.
# ============================================================

# Gmail SMTP Credentials
# Use a Gmail App Password (NOT your real Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the account.)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Display name shown in the "From" field of sent emails
MAIL_FROM_NAME=Santa Fe Beach Club
