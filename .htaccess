# ════════════════════════════════════════════════════════════════════════════════
#  Santa Fe Beach Club — Server Security & Dynamic Routing (.htaccess)
# ════════════════════════════════════════════════════════════════════════════════
# Disable Directory Listing
Options -Indexes

# Protect Sensitive Files
<FilesMatch "^\.env|config\.php|database\.sql|\.log|\.md|\.ini$">
    Require all denied
</FilesMatch>

RewriteEngine On

# ── Dynamic rewrite base / path routing ──────────────────────────────────────────

# Directly serve static assets (CSS, JS, images, etc.) from frontend/assets
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^assets/(.+)$ frontend/assets/$1 [L]

# Directly serve uploaded receipts and photos
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^uploads/(.+)$ frontend/uploads/$1 [L]

# Directly serve backend endpoints if requested
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^backend/(.+)$ backend/$1 [L,QSA]

# Dynamic clean URL rewrite for root requests:
# e.g., /accommodations -> frontend/accommodations.php
# e.g., /admin_dashboard -> frontend/admin_dashboard.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^frontend/(.+)\.php$ frontend/$1.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ frontend/$1.php [L,QSA]
